# TeacherScenarioLab 生产环境变量模板
#
# 用法：复制为 .env.local 再填入真实值。此模板受版本控制，实际配置受忽略规则保护。
# 注意：openmaic.yml 一旦存在，legacy 的 *_API_KEY 三元组与 DEFAULT_MODEL
# 全部失效；模型配置以 openmaic.yml 为准，本文件只提供密钥。

# ---- 数据库（必填）----
# 使用字母数字组成的高熵口令；应用连接串和 PostgreSQL 初始化口令必须一致。
PERSISTENCE_POSTGRES_PASSWORD=
DATABASE_URL=postgres://openmaic:${PERSISTENCE_POSTGRES_PASSWORD}@postgres:5432/openmaic

# 保存用户模型密钥的加密根密钥；所有副本使用同一高熵值，并纳入受保护备份。
# 更换该值会使既有密文不可读，需保留旧密钥或重新录入供应商密钥。
OPENMAIC_SECRET_KEY=

# ---- 训练账号与权限 ----
# 必须设为 false：Compose 默认的单人模式（true）会让所有请求解析为同一个
# owner，破坏训练的账号 / 匿名 / 认领模型。
OWNER_SINGLE_USER=false
# 管理员账号 ID（逗号分隔，形如 acct:<uuid>）。管理员永不自助授予。
TRAINING_ADMIN_ACCOUNT_IDS=

# ---- 模型密钥（只进本文件，绝不进 YAML 明文、源码或 Git）----
# 由 openmaic.yml 以 ${NVIDIA_API_KEY} / ${GLM_API_KEY} 引用。
NVIDIA_API_KEY=
GLM_API_KEY=
# 从供应商模型目录/账号控制台核验后填写精确 ID。
NVIDIA_MODEL_ID=
GLM_MODEL_ID=

# ---- 对外发布 ----
# 对外发布前必须设强值；无 ACCESS_CODE 时 Compose 默认只绑 127.0.0.1。
ACCESS_CODE=
# 需要对外发布时设为 0.0.0.0（或指定网卡），并配合反代/隧道做 HTTPS。
OPENMAIC_PUBLISH_ADDRESS=127.0.0.1
