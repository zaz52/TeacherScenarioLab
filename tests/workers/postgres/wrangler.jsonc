{
  "name": "teacherlab-postgres-contract",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "DATABASE_HOST", "class_name": "DatabaseHostProbe" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DatabaseHostProbe"] }],
}
